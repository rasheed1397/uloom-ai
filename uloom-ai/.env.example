# --- App ---
APP_ENV=local
SECRET_KEY=change-me

# --- Database (SRS Section 7) ---
DATABASE_URL=postgresql+asyncpg://uloom:uloom@localhost:5432/uloom
REDIS_URL=redis://localhost:6379/0

# --- AI provider selection (Detailed Design Section 5.6: config-driven, independently settable) ---
AI_CHAT_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=gemini
# NFR-005/SRS Section 9: routed to on repeated provider timeout, after one
# retry, if set. Empty (default) means no fallback - matches the current
# single-vendor-for-v1 decision (Detailed Design Section 5.5).
AI_CHAT_PROVIDER_FALLBACK=
AI_EMBEDDING_PROVIDER_FALLBACK=

# Gemini (default provider, both capabilities - Detailed Design Section 5.5)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Alternate provider keys (only needed if AI_CHAT_PROVIDER / AI_EMBEDDING_PROVIDER point at them)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# --- Retrieval tuning (admin-configurable per FR-009) ---
RETRIEVAL_TOP_K=5
CHUNK_TOKEN_SIZE=512
SIMILARITY_THRESHOLD=0.7
# SRS Section 10: default retention period (days) for uploaded documents and
# conversation history, applied by a daily background sweep (app.core.
# retention). Admin-configurable at runtime via PATCH /admin/settings.
RETENTION_DAYS=90

# --- Document storage (Detailed Design Section 6: local volume for v1) ---
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=25

# --- Admin bootstrap (FR-009) ---
# Promotes this email to ADMIN *if/when it registers* - doesn't create an
# account by itself. Comma-separated for more than one.
ADMIN_BOOTSTRAP_EMAILS=
# Actually creates an admin account at startup, so one exists before anyone
# has registered at all. Set both or neither - no account is created
# unless both are present, and there's no default password.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# --- CORS: origins allowed to call this API from a browser. Default covers
# the Vite dev server over https (NFR-004 - see frontend/nginx.conf). A JSON
# array string (pydantic-settings parses complex types this way), e.g.
# CORS_ALLOWED_ORIGINS=["https://localhost:5173"] ---
# CORS_ALLOWED_ORIGINS=["https://localhost:5173"]

# --- TLS (NFR-004): both the api and frontend containers generate a
# self-signed certificate at startup (docker-entrypoint.sh in each) and
# serve HTTPS only. Nothing to configure here - but your browser will show
# a one-time untrusted-certificate warning for each origin
# (https://localhost:8000 and https://localhost:5173) the first time you
# visit; accept it to continue. A real deployment terminates TLS at a load
# balancer/ingress with a CA-issued certificate instead of this local cert.
